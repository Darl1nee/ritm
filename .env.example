# База данных Turso (для деплоя в Vercel)
# Получить бесплатно на https://turso.tech или через `turso db create ritm-db`
DATABASE_URL=libsql://your-db-name-your-username.turso.io
DATABASE_AUTH_TOKEN=your-turso-auth-token

# Если переменные не заданы, локально проект автоматически работает с файлом ./data/ritm.db
